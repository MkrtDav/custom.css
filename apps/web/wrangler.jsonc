{
  "name": "stakeholders-cc",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "stakeholders.cc", "custom_domain": true },
    { "pattern": "www.stakeholders.cc", "custom_domain": true },
    { "pattern": "italy.stakeholders.cc", "custom_domain": true },
    { "pattern": "dev.italy.stakeholders.cc", "custom_domain": true }
  ]
}
